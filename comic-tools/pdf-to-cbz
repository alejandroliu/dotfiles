#!/usr/bin/env python3
import math
import os
import re
import sys
import tempfile
import subprocess
import zipfile
import xml.etree.ElementTree as ET
from xml.dom import minidom
from pathlib import Path

try:
  from icecream import ic
except ImportError:  # Graceful fallback if IceCream isn't installed.
  ic = lambda *a: None if not a else (a[0] if len(a) == 1 else a)  # noqa

def get_max_dpi(pdf_path: Path, default_dpi: int = 200) -> int:
  '''Calculates the highest DPI of embedded raster images using pdfimages.'''
  try:
    result = subprocess.run(
      ['pdfimages', '-list', str(pdf_path)],
      capture_output=True,
      text=True,
      check=True
    )
    lines = result.stdout.strip().splitlines()[2:]  # Skip header lines
    dpis = []
    for line in lines:
      parts = line.split()
      if len(parts) >= 14:
        # Resolution values are typically in columns 13 and 14 (0-indexed 12 & 13)
        for val in (parts[12], parts[13]):
          if val.isdigit():
            dpis.append(int(val))
    raw_dpi = max(dpis) if dpis and max(dpis) >= 72 else default_dpi
  except Exception:
    return default_dpi
  return math.ceil(raw_dpi / 50.0) * 50


def parse_ebook_meta(pdf_path: Path) -> dict:
  '''Runs ebook-meta and returns a dictionary of key metadata fields.'''
  metadata = {}
  try:
    result = subprocess.run(
      ['ebook-meta', str(pdf_path)],
      capture_output=True,
      text=True,
      check=True
    )
    for line in result.stdout.splitlines():
      if ':' in line:
        key, val = line.split(':', 1)
        key = key.strip().lower()
        val = val.strip()
        if key == 'author(s)':
          key = 'authors'
          if (i:=val.find('[')) > 0: val = val[:i]
          val = val.replace('&',',')
        elif key == 'title':
          if (i:=val.find('[')) > 0: val = val[:i]
        elif key == 'series':
          if (i := val.rfind('#')) > 0:
            metadata['index'] = val[i+1:]
            val = val[:i]
        elif key == 'identifiers':
          val = [i.strip()[5:] for i in val.split(',') if i.strip().lower().startswith('isbn:') ]
          if val:
            key = 'isbn'
            val = val[0]
          else:
            continue
        metadata[key] = val
  except Exception as e:
    print(f'Warning: Failed to extract metadata using ebook-meta: {e}')
  return metadata

def generate_comic_info(metadata: dict, output_path: Path):
  '''Generates a formatted ComicInfo.xml file.'''
  root = ET.Element('ComicInfo', {
    'xmlns:xsi': 'http://www.w3.org/2001/XMLSchema-instance',
    'xmlns:xsd': 'http://www.w3.org/2001/XMLSchema'
  })

  # Parse Published Date (e.g., 2010-09-20T14:44:12+00:00)
  pub_date = metadata.get('published', '')
  year, month, day = '', '', ''
  date_match = re.match(r'^(\d{4})-(\d{2})-(\d{2})', pub_date)
  if date_match:
    year = date_match.group(1)
    month = str(int(date_match.group(2)))  # Strip leading zero
    day = str(int(date_match.group(3)))    # Strip leading zero

  # Map metadata fields to ComicInfo XML tags
  tag_mappings = {
    'Title': metadata.get('title', ''),
    'Series': metadata.get('series', ''),
    'Number': metadata.get('index', ''),  # Fixed typo ('Iidex' -> 'index')
    'Writer': metadata.get('authors', ''),
    'Publisher': metadata.get('publisher', ''),
    'Genre': metadata.get('tags', ''),
    'Tags': metadata.get('tags', ''),
    'Summary': metadata.get('comments', ''),
    'Year': year,
    'Month': month,
    'Day': day,
    'LanguageISO': metadata.get('language', ''),
    'GTIN': metadata.get('isbn', ''),
    'CommunityRating': metadata.get('rating', '')
  }

  for tag_name, text_val in tag_mappings.items():
    if text_val:
      node = ET.SubElement(root, tag_name)
      node.text = text_val

  # Pretty print XML string
  xml_str = minidom.parseString(ET.tostring(root, encoding='utf-8')).toprettyxml(indent='  ')

  # Clean up empty lines generated by minidom
  xml_clean = '\n'.join([line for line in xml_str.splitlines() if line.strip()])
  output_path.write_text(xml_clean, encoding='utf-8')

def natural_sort_key(path: Path):
  '''Sorts filenames naturally so page-2 comes before page-10.'''
  return [int(text) if text.isdigit() else text.lower() for text in re.split(r'(\d+)', path.name)]

def main():
  if len(sys.argv) < 2:
    print(f'Usage: {sys.argv[0]} <path-to-pdf-file>')
    sys.exit(1)

  for i in sys.argv[1:]:
    pdf_file = Path(i).resolve()
    if not pdf_file.is_file():
      print(f'Error: File \'{pdf_file}\' not found!')
      sys.exit(1)

    sys.stderr.write('Extracting metadata using ebook-meta...\n')
    metadata = parse_ebook_meta(pdf_file)
    ic(metadata)

    cbz_file = pdf_file.with_suffix('.cbz')

    # Create temporary directory for extraction
    with tempfile.TemporaryDirectory() as work_dir_str:
      work_dir = Path(work_dir_str)

      sys.stderr.write('Generating ComicInfo.xml...\n')
      generate_comic_info(metadata, work_dir / 'ComicInfo.xml')

      dpi = get_max_dpi(pdf_file)
      sys.stderr.write(f'Extracting pages from \'{pdf_file.name}\' at {dpi} DPI...\n')
      subprocess.run(
        ['pdftoppm', '-progress', '-jpeg', '-r', str(dpi), str(pdf_file), str(work_dir / 'page')],
        check=True
      )

      sys.stderr.write(f'Creating CBZ archive at \'{cbz_file.name}\'...\n')
      
      # Gather extracted files and sort them naturally
      files_to_add = [f for f in work_dir.iterdir() if f.is_file()]
      files_to_add.sort(key=natural_sort_key)

      # Write files directly to the target CBZ file in sorted order
      with zipfile.ZipFile(cbz_file, 'w', compression=zipfile.ZIP_STORED) as cbz:
        for file_path in files_to_add:
          cbz.write(file_path, arcname=file_path.name)

    sys.stderr.write('Done!\n')

if __name__ == '__main__':
  main()
