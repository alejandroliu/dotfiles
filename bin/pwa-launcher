#!/bin/sh
set -euf ; ( set -o pipefail 2>/dev/null) && set -o pipefail  || :

# ------------------------------------------------------------
# Initialize all variables to satisfy `-u`
# ------------------------------------------------------------
URL=""
PAGE=""
MANIFEST=""
MANIFEST_HREF=""
MANIFEST_URL=""
NAME=""
SHORT_NAME=""
START_URL=""
DISPLAY=""
ICON_SRC=""
TITLE=""
TITLE_OVERRIDE=""
ICON_OVERRIDE=""
BROWSER=""
DOMAIN=""
APP_ID=""
ICON_PATH=""
DESKTOP_FILE=""
ADD_DESKTOP_ICON=false

ICON_DIR="$HOME/.local/share/icons/pwa-launcher"
DESKTOP_DIR="$HOME/.local/share/applications"
USER_DESKTOP="$HOME/Desktop"

# ------------------------------------------------------------
usage() {
    echo "Usage: $0 [options] <url>"
    echo "Options:"
    echo "  --browser <cmd>     Override browser"
    echo "  --title <title>     Override title"
    echo "  --icon <file>       Override icon"
    echo "  --desktop           Add icon to ~/Desktop"
    exit 1
}

detect_browser() {
    for b in firefox chromium google-chrome chrome; do
        if command -v "$b" >/dev/null 2>&1; then
            BROWSER="$b"
            return
        fi
    done
    echo "ERROR: No supported browser found" >&2
    exit 1
}

sanitize() {
    echo "$1" | tr -cd '[:alnum:]._-'
}

resolve_url() {
    case "$1" in
        http* ) echo "$1" ;;
        /* ) echo "$BASE_URL$1" ;;
        * ) echo "$BASE_URL/$1" ;;
    esac
}

download_icon() {
    src="$1"
    out="$2"
    tmp="$out.tmp"

    # curl must not kill the script
    if ! curl -Ls "$src" -o "$tmp"; then
        rm -f "$tmp"
        return 1
    fi

    case "$src" in
        *.ico|*.ICO|*.svg|*.SVG)
            # magick must not kill the script
            if ! magick "$tmp" "$out" 2>/dev/null; then
                mv "$tmp" "$out"
            fi
            ;;
        *)
            mv "$tmp" "$out"
            ;;
    esac

    rm -f "$tmp"
}

# ------------------------------------------------------------
# Parse arguments
# ------------------------------------------------------------
while [ $# -gt 0 ]; do
    case "$1" in
        --browser) BROWSER="$2"; shift 2 ;;
        --title) TITLE_OVERRIDE="$2"; shift 2 ;;
        --icon) ICON_OVERRIDE="$2"; shift 2 ;;
        --desktop) ADD_DESKTOP_ICON=true; shift ;;
        -* ) usage ;;
        * ) URL="$1"; shift ;;
    esac
done

[ -z "$URL" ] && usage

$ADD_DESKTOP_ICON && mkdir -p "$ICON_DIR" "$DESKTOP_DIR"

[ -z "$BROWSER" ] && detect_browser

# ------------------------------------------------------------
# Extract domain → used for filename
# ------------------------------------------------------------
DOMAIN=$(echo "$URL" | sed -E 's|https?://([^/]+).*|\1|')
APP_ID=$(sanitize "$DOMAIN")
BASE_URL="https://$DOMAIN"

# ------------------------------------------------------------
# Download HTML page ONCE (must not kill script)
# ------------------------------------------------------------
PAGE=$(curl -Ls "$URL" || :)

if [ -z "$PAGE" ]; then
    echo "ERROR: Failed to download page: $URL" >&2
    exit 1
fi

# ------------------------------------------------------------
# Extract manifest URL (pipefail-safe)
# ------------------------------------------------------------

MANIFEST_HREF=$(printf "%s" "$PAGE" \
    | grep -i 'rel=["'\'']manifest' 2>/dev/null  \
    | sed -n 's/.*href=["'\'']\([^"'\'' ]*\).*/\1/p' \
    | head -n1 || :)

if [ -n "$MANIFEST_HREF" ]; then
    MANIFEST_URL=$(resolve_url "$MANIFEST_HREF")
    MANIFEST=$(curl -Ls "$MANIFEST_URL" || :)
else
    MANIFEST=""
fi

if [ -z "$MANIFEST" ]; then
  echo "WARNING: No PWA manifest found — falling back to HTML metadata."
fi

# ------------------------------------------------------------
# Parse manifest (jq must not kill script)
# ------------------------------------------------------------
if [ -n "$MANIFEST" ]; then
    NAME=$(printf "%s" "$MANIFEST" | jq -r '.name // empty' 2>/dev/null || :)
    SHORT_NAME=$(printf "%s" "$MANIFEST" | jq -r '.short_name // empty' 2>/dev/null || :)
    START_URL=$(printf "%s" "$MANIFEST" | jq -r '.start_url // empty' 2>/dev/null || :)
    DISPLAY=$(printf "%s" "$MANIFEST" | jq -r '.display // empty' 2>/dev/null || :)

    ICON_SRC=$(printf "%s" "$MANIFEST" \
        | jq -r '.icons[]? | select(.type|test("png|svg|ico"; "i")) | .src' \
        2>/dev/null \
        | head -n1 || :)
fi

# ------------------------------------------------------------
# Determine title
# ------------------------------------------------------------
if [ -n "$TITLE_OVERRIDE" ]; then
    TITLE="$TITLE_OVERRIDE"
else
    if [ -n "$NAME" ]; then
        TITLE="$NAME"
    elif [ -n "$SHORT_NAME" ]; then
        TITLE="$SHORT_NAME"
    else
        TITLE=$(printf "%s" "$PAGE" \
            | grep -i "<title>" 2>/dev/null \
            | head -n1 \
            | sed -e 's/.*<title>//I' -e 's/<\/title>.*//I' || echo "")
        [ -z "$TITLE" ] && TITLE="Web App"
    fi
fi

# ------------------------------------------------------------
# Determine start URL
# ------------------------------------------------------------
if [ -n "$START_URL" ]; then
    START_URL=$(resolve_url "$START_URL")
else
    START_URL="$URL"
fi

# ------------------------------------------------------------
# Determine icon
# ------------------------------------------------------------
ICON_PATH="$ICON_DIR/$APP_ID.png"

if [ -n "$ICON_OVERRIDE" ]; then
    cp "$ICON_OVERRIDE" "$ICON_PATH"
else
    if [ -n "$ICON_SRC" ]; then
        ICON_URL=$(resolve_url "$ICON_SRC")
        download_icon "$ICON_URL" "$ICON_PATH" || touch "$ICON_PATH"
    else
        FAVICON=$(printf "%s" "$PAGE" \
            | grep -iE 'rel="(icon|shortcut icon)"' 2>/dev/null \
            | sed -n 's/.*href=["'\'']\([^"'\'' ]*\).*/\1/p' \
            | head -n1 || :)

        if [ -n "$FAVICON" ]; then
            ICON_URL=$(resolve_url "$FAVICON")
            download_icon "$ICON_URL" "$ICON_PATH" || touch "$ICON_PATH"
        else
            touch "$ICON_PATH"
        fi
    fi
fi

# ------------------------------------------------------------
# Create .desktop file
# ------------------------------------------------------------
DESKTOP_FILE="$DESKTOP_DIR/${APP_ID}.desktop"

case "$DISPLAY" in
    standalone|minimal-ui|fullscreen)
        EXEC="$BROWSER --new-window \"$START_URL\"" ;;
    *)
      if (echo "$BROWSER" | grep -q /firefox) ; then
        EXEC="$BROWSER --new-window \"$START_URL\""
      else
        EXEC="$BROWSER \"$START_URL\""
      fi
      ;;
esac

cat > "$DESKTOP_FILE" <<EOF
[Desktop Entry]
Type=Application
Name=$TITLE
Exec=$EXEC
Icon=$ICON_PATH
Terminal=false
Categories=Network;WebBrowser;
StartupWMClass=$APP_ID
EOF

chmod +x "$DESKTOP_FILE"

$ADD_DESKTOP_ICON && cp "$DESKTOP_FILE" "$USER_DESKTOP/${APP_ID}.desktop"

echo "PWA launcher created:"
echo "  $DESKTOP_FILE"
$ADD_DESKTOP_ICON  && echo "Desktop icon added."
